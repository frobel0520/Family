# Copy to .env.local (gitignored) and fill in for local development.
# The OAuth Client ID is public by design but differs between environments, so it
# isn't committed. Production builds read the repository variable of the same name
# in .github/workflows/publish-worker.yml.
#
# The API is same-origin now (the Worker serves this frontend), so there is no
# API base URL to configure: build the frontend, then run `wrangler dev` in worker/.

VITE_GOOGLE_CLIENT_ID=
